generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TournamentStatus {
  ACTIVE
  ARCHIVED
}

enum WrestlingStyle {
  FS
  WW
  GR
}

enum AgeCategory {
  SENIOR
  U23
  U20
  U17
  U15
}

enum DivisionFormat {
  SINGLE_BOUT
  NORDIC
  GROUP_CROSS
  ELIMINATION_REPECHAGE
}

enum BoutStatus {
  TBD
  SCHEDULED
  ON_DECK
  IN_PROGRESS
  COMPLETED
}

enum Corner {
  RED
  BLUE
}

enum BracketSide {
  TOP
  BOTTOM
}

enum VictoryType {
  VFA
  VSU
  VSU1
  VPO
  VPO1
  DSQ
  VIN
  VFO
}

enum MatchPhase {
  PRE_MATCH
  PERIOD_1
  BREAK
  PERIOD_2
  FINISHED
}

enum MatchEventType {
  POINT
  CAUTION
  PASSIVITY
  ACTIVITY_POINT
  CHALLENGE_LOST_POINT
  MANUAL_ADJUST
}

model Tournament {
  id        String           @id @default(uuid()) @db.Char(36)
  name      String           @db.VarChar(255)
  location  String?          @db.VarChar(255)
  eventDate DateTime?        @map("event_date")
  status    TournamentStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")

  divisions Division[]
  athletes  Athlete[]
  bouts     Bout[]

  @@map("tournaments")
}

model Division {
  id           String         @id @default(uuid()) @db.Char(36)
  tournamentId String         @map("tournament_id") @db.Char(36)
  style        WrestlingStyle
  ageCategory  AgeCategory    @map("age_category")
  weightClass  String         @map("weight_class") @db.VarChar(50)
  format       DivisionFormat
  assignedMat  String         @default("MAT A") @map("assigned_mat") @db.VarChar(50)
  isDrawLocked Boolean        @default(false) @map("is_draw_locked")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  athletes   Athlete[]
  bouts      Bout[]

  @@unique([tournamentId, style, ageCategory, weightClass])
  @@map("divisions")
}

model Athlete {
  id           String @id @default(uuid()) @db.Char(36)
  tournamentId String @map("tournament_id") @db.Char(36)
  divisionId   String @map("division_id") @db.Char(36)
  name         String @db.VarChar(255)
  region       String @db.VarChar(255)
  regionCode   String @map("region_code") @db.VarChar(20)
  seed         Int?
  drawNumber   Int?   @map("draw_number")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  division   Division   @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  redBouts  Bout[] @relation("RedAthlete")
  blueBouts Bout[] @relation("BlueAthlete")
  wonBouts  Bout[] @relation("WinnerAthlete")

  @@map("athletes")
}

model Bout {
  id                    String       @id @default(uuid()) @db.Char(36)
  tournamentId          String?      @map("tournament_id") @db.Char(36)
  divisionId            String?      @map("division_id") @db.Char(36)
  boutNumber            Int?         @map("bout_number")
  matName               String       @default("MAT A") @map("mat_name") @db.VarChar(50)
  round                 String       @db.VarChar(50)
  roundOrder            Int          @default(10) @map("round_order")
  bracketPosition       Int          @default(1) @map("bracket_position")
  bracketSide           BracketSide? @map("bracket_side")
  redAthleteId          String?      @map("red_athlete_id") @db.Char(36)
  blueAthleteId         String?      @map("blue_athlete_id") @db.Char(36)
  redManualName         String?      @map("red_manual_name") @db.VarChar(255)
  redManualRegion       String?      @map("red_manual_region") @db.VarChar(50)
  blueManualName        String?      @map("blue_manual_name") @db.VarChar(255)
  blueManualRegion      String?      @map("blue_manual_region") @db.VarChar(50)
  redSourceLabel        String?      @map("red_source_label") @db.VarChar(100)
  blueSourceLabel       String?      @map("blue_source_label") @db.VarChar(100)
  nextWinBoutId         String?      @map("next_win_bout_id") @db.Char(36)
  nextWinSlot           Corner?      @map("next_win_slot")
  nextLoseBoutId        String?      @map("next_lose_bout_id") @db.Char(36)
  nextLoseSlot          Corner?      @map("next_lose_slot")
  status                BoutStatus   @default(TBD)
  winnerCorner          Corner?      @map("winner_corner")
  winnerAthleteId       String?      @map("winner_athlete_id") @db.Char(36)
  redScore              Int          @default(0) @map("red_score")
  blueScore             Int          @default(0) @map("blue_score")
  victoryType           VictoryType? @map("victory_type")
  redClassificationPts  Int          @default(0) @map("red_classification_pts")
  blueClassificationPts Int          @default(0) @map("blue_classification_pts")
  completedAt           DateTime?    @map("completed_at")

  tournament    Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  division      Division?   @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  redAthlete    Athlete?    @relation("RedAthlete", fields: [redAthleteId], references: [id], onDelete: SetNull)
  blueAthlete   Athlete?    @relation("BlueAthlete", fields: [blueAthleteId], references: [id], onDelete: SetNull)
  winnerAthlete Athlete?    @relation("WinnerAthlete", fields: [winnerAthleteId], references: [id], onDelete: SetNull)

  nextWinBout  Bout?  @relation("NextWinBout", fields: [nextWinBoutId], references: [id], onDelete: SetNull)
  prevWinBouts Bout[] @relation("NextWinBout")

  nextLoseBout  Bout?  @relation("NextLoseBout", fields: [nextLoseBoutId], references: [id], onDelete: SetNull)
  prevLoseBouts Bout[] @relation("NextLoseBout")

  matchSession MatchSession?
  matchEvents  MatchEventRecord[]

  @@index([tournamentId, matName, status])
  @@index([divisionId, roundOrder])
  @@map("bouts")
}

model MatchSession {
  boutId                String     @id @map("bout_id") @db.Char(36)
  matName               String?    @unique @map("mat_name") @db.VarChar(50)
  version               Int        @default(1)
  phase                 MatchPhase @default(PRE_MATCH)
  mainClockJson         Json       @map("main_clock_json")
  breakClockJson        Json       @map("break_clock_json")
  activityClockJson     Json       @map("activity_clock_json")
  redStateJson          Json       @map("red_state_json")
  blueStateJson         Json       @map("blue_state_json")
  activeChallengeCorner Corner?    @map("active_challenge_corner")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  bout Bout @relation(fields: [boutId], references: [id], onDelete: Cascade)

  @@map("match_sessions")
}

model MatchEventRecord {
  id           String         @id @default(uuid()) @db.Char(36)
  boutId       String         @map("bout_id") @db.Char(36)
  sequenceNo   Int            @map("sequence_no")
  period       Int            @db.TinyInt
  matchClockMs Int            @map("match_clock_ms")
  corner       Corner
  type         MatchEventType
  points       Int
  note         String?        @db.VarChar(255)
  isUndone     Boolean        @default(false) @map("is_undone")
  createdAt    DateTime       @default(now()) @map("created_at")

  bout Bout @relation(fields: [boutId], references: [id], onDelete: Cascade)

  @@index([boutId, isUndone, sequenceNo])
  @@map("match_events")
}
