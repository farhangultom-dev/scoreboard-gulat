{
  "name": "scoreboard-gulat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm --prefix server run dev",
    "dev:all": "concurrently -n \"VITE,SERVER\" -c \"cyan,amber\" \"npm run dev\" \"npm --prefix server run dev\"",
    "build": "tsc --noEmit && vite build",
    "build:server": "npm --prefix server run build",
    "build:all": "npm run build && npm run build:server",
    "start:local": "npm --prefix server run start",
    "preview": "vite preview",
    "test": "vitest"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "socket.io-client": "^4.8.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.0.7"
  }
}
